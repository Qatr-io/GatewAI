      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "${datasource_tempo}"
          },
          "queryType": "traceql",
          "query": "{service.name=~\"gatewai.*\"} | quantile_over_time(duration, 0.95) by(span.name)",
