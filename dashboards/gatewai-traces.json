        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "${datasource_tempo}"
          },
          "queryType": "traceql",
          "query": "{status=error, service.name=~\"gatewai.*\"} | rate() by(resource.service.name)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
