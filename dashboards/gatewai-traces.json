  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "title": "Carte des services",
      "type": "row"
    },
    {
      "id": 2,
      "title": "Service Map — Topologie GatewAI",
      "type": "nodeGraph",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 24,
        "h": 12
      },
      "datasource": {
        "type": "tempo",
        "uid": "${datasource_tempo}"
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "${datasource_tempo}"
          },
          "queryType": "serviceMap",
          "serviceMapQuery": "{service.name=~\"gatewai.*\"}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "nodes": {
          "arcs": [
            {
              "color": "blue",
              "field": "arc__success"
            },
            {
              "color": "red",
              "field": "arc__failed"
            }
          ]
        },
        "edges": {}
      },
      "description": "Nécessite le Metrics Generator de Tempo (metrics_generator.registry). Affiche la topologie gateway → relay → inference."
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "id": 3,
      "title": "RED — Métriques par opération (TraceQL)",
      "type": "row"
    },
    {
      "id": 4,
      "title": "Débit spans/s par service",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "${datasource_tempo}"
          },
          "queryType": "traceql",
          "query": "{service.name=~\"gatewai.*\"} | rate() by(resource.service.name)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 8,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": false
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "title": "Taux d'erreurs spans/s",
