{
  "id": null,
  "uid": "gatewai-audit-trail",
  "title": "GatewAI — Audit Trail LLM",
  "description": "Supervision des requêtes LLM : flux audit, guardrails PII, cache, backend health, tokens par consumer.",
  "tags": ["GatewAI", "llm", "audit", "guardrails"],
  "timezone": "browser",
  "schemaVersion": 37,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-3h", "to": "now" },
  "timepicker": {},
  "links": [
    {
      "title": "GatewAI — LLM Proxy",
      "url": "/d/gatewai-llm",
      "type": "link",
      "icon": "external link",
      "targetBlank": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "label": "Prometheus",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "options": [],
        "refresh": 1,
        "regex": ""
      },
      {
        "name": "loki_datasource",
        "type": "datasource",
        "label": "Loki",
        "query": "loki",
        "current": {},
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "options": [],
        "refresh": 1,
        "regex": ""
      },
      {
        "name": "namespace",
        "type": "query",
        "label": "Namespace",
        "datasource": { "type": "loki", "uid": "${loki_datasource}" },
        "query": "label_values(namespace)",
        "current": {},
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "options": [],
        "refresh": 2,
        "regex": ".*gatewai.*",
        "sort": 1
      },
      {
        "name": "service_type",
        "type": "query",
        "label": "Service type",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": {
          "query": "label_values(gatewai_llm_requests_total, service_type)",
          "refId": "StandardVariableQuery"
        },
        "current": {},
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "options": [],
        "refresh": 2,
        "regex": "",
        "allValue": ".*"
      },
      {
        "name": "model",
        "type": "query",
        "label": "Modèle",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": {
          "query": "label_values(gatewai_llm_requests_total{service_type=~\"$service_type\"}, model)",
          "refId": "StandardVariableQuery"
        },
        "current": {},
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "options": [],
        "refresh": 2,
        "regex": "",
        "allValue": ".*"
      }
    ]
  },
  "panels": [

    {
      "type": "row",
      "id": 1,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "title": "Vue globale",
      "collapsed": false
    },

    {
      "type": "stat",
      "id": 2,
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "title": "Requêtes LLM (fenêtre)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "options": {
        "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          },
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(increase(gatewai_llm_requests_total{service_type=~\"$service_type\", model=~\"$model\", provider!~\"cache|semantic-cache\"}[$__range]))",
          "legendFormat": "total",
          "refId": "A"
        }
      ]
    },

    {
      "type": "stat",
      "id": 3,
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "title": "Taux d'erreur 5xx",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          },
          "unit": "percent",
          "decimals": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "100 * sum(rate(gatewai_llm_requests_total{service_type=~\"$service_type\", model=~\"$model\", status=~\"5..\", provider!~\"cache|semantic-cache\"}[5m])) / (sum(rate(gatewai_llm_requests_total{service_type=~\"$service_type\", model=~\"$model\", provider!~\"cache|semantic-cache\"}[5m])) > 0)",
          "legendFormat": "erreurs 5xx %",
          "refId": "A"
        }
      ]
    },

    {
      "type": "stat",
      "id": 4,
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "title": "Cache hit rate (exact)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 20 },
              { "color": "green", "value": 50 }
            ]
          },
          "unit": "percent",
          "decimals": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "100 * sum(rate(gatewai_cache_hits_total{service_type=~\"$service_type\", model=~\"$model\"}[5m])) / (sum(rate(gatewai_cache_hits_total{service_type=~\"$service_type\", model=~\"$model\"}[5m])) + sum(rate(gatewai_cache_misses_total{service_type=~\"$service_type\", model=~\"$model\"}[5m])) > 0)",
          "legendFormat": "exact hit %",
          "refId": "A"
        }
      ]
    },

    {
      "type": "stat",
      "id": 5,
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "title": "Cache hit rate (sémantique)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "green", "value": 30 }
            ]
          },
          "unit": "percent",
          "decimals": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "100 * sum(rate(gatewai_llm_requests_total{service_type=~\"$service_type\", model=~\"$model\", provider=\"semantic-cache\"}[5m])) / (sum(rate(gatewai_llm_requests_total{service_type=~\"$service_type\", model=~\"$model\", provider!~\"cache\"}[5m])) > 0)",
          "legendFormat": "semantic hit %",
          "refId": "A"
        }
      ]
    },

    {
      "type": "stat",
      "id": 6,
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "title": "Requêtes bloquées PII",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "options": {
        "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          },
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(increase(gatewai_guardrails_pii_blocked_total{service_type=~\"$service_type\", model=~\"$model\"}[$__range]))",
          "legendFormat": "bloquées",
          "refId": "A"
        }
      ]
    },

    {
      "type": "timeseries",
      "id": 7,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "title": "Taux de requêtes/s par provider",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 1, "fillOpacity": 10 },
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (provider) (rate(gatewai_llm_requests_total{service_type=~\"$service_type\", model=~\"$model\"}[5m]))",
          "legendFormat": "{{provider}}",
          "refId": "A"
        }
      ]
    },

    {
      "type": "timeseries",
      "id": 8,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "title": "Latence LLM p50 / p95 / p99",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 1, "fillOpacity": 5 },
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(gatewai_llm_request_duration_seconds_bucket{service_type=~\"$service_type\", model=~\"$model\", provider!~\"cache|semantic-cache\"}[5m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(gatewai_llm_request_duration_seconds_bucket{service_type=~\"$service_type\", model=~\"$model\", provider!~\"cache|semantic-cache\"}[5m])))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(gatewai_llm_request_duration_seconds_bucket{service_type=~\"$service_type\", model=~\"$model\", provider!~\"cache|semantic-cache\"}[5m])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },

    {
      "type": "row",
      "id": 10,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 },
      "title": "Guardrails PII",
      "collapsed": false
    },

    {
      "type": "timeseries",
      "id": 11,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "title": "Requêtes bloquées PII / s",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 20 },
          "unit": "reqps",
          "color": { "fixedColor": "orange", "mode": "fixed" }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (service_type, model) (rate(gatewai_guardrails_pii_blocked_total{service_type=~\"$service_type\", model=~\"$model\"}[5m]))",
          "legendFormat": "{{service_type}}/{{model}}",
          "refId": "A"
        }
      ]
    },

    {
      "type": "timeseries",
      "id": 12,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "title": "Ratio requêtes bloquées PII (%)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 1, "fillOpacity": 10 },
          "unit": "percent"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "100 * sum(rate(gatewai_guardrails_pii_blocked_total{service_type=~\"$service_type\", model=~\"$model\"}[5m])) / (sum(rate(gatewai_llm_requests_total{service_type=~\"$service_type\", model=~\"$model\", provider!~\"cache|semantic-cache\"}[5m])) + sum(rate(gatewai_guardrails_pii_blocked_total{service_type=~\"$service_type\", model=~\"$model\"}[5m])) > 0)",
          "legendFormat": "% bloquées",
          "refId": "A"
        }
      ]
    },

    {
      "type": "logs",
      "id": 13,
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 22 },
      "title": "Logs PII bloqués",
      "datasource": { "type": "loki", "uid": "${loki_datasource}" },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": false
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${loki_datasource}" },
          "expr": "{namespace=\"$namespace\"} | json | msg=`llm request blocked: PII detected`",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },

    {
      "type": "row",
      "id": 20,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 },
      "title": "Backend Health",
      "collapsed": false
    },

    {
      "type": "bargauge",
      "id": 21,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 33 },
      "title": "Poids effectifs backends (0 = exclu)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "valueMode": "color",
        "showUnfilled": true
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "green", "value": 50 }
            ]
          },
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "gatewai_backend_effective_weight",
          "legendFormat": "{{url}}",
          "refId": "A"
        }
      ]
    },

    {
      "type": "timeseries",
      "id": 22,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 33 },
      "title": "Erreurs 5xx/s par backend",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 1, "fillOpacity": 15 },
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (backend_model, provider) (rate(gatewai_llm_requests_total{service_type=~\"$service_type\", model=~\"$model\", status=~\"5..\", provider!~\"cache|semantic-cache\"}[5m]))",
          "legendFormat": "{{provider}}/{{backend_model}}",
          "refId": "A"
        }
      ]
    },

    {
      "type": "row",
      "id": 30,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 41 },
      "title": "Flux Audit LLM (Loki)",
      "collapsed": false
    },

    {
      "type": "logs",
      "id": 31,
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 42 },
      "title": "Audit — requêtes LLM",
      "datasource": { "type": "loki", "uid": "${loki_datasource}" },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": false
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${loki_datasource}" },
          "expr": "{namespace=\"$namespace\"} | json | msg=`llm request` | service_type=~`$service_type` | model=~`$model`",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },

    {
      "type": "timeseries",
      "id": 32,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 56 },
      "title": "Tokens/s par user_type (audit)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 1, "fillOpacity": 10 },
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (user_type, type) (rate(gatewai_llm_tokens_total{service_type=~\"$service_type\", model=~\"$model\"}[5m]))",
          "legendFormat": "{{user_type}} — {{type}}",
          "refId": "A"
        }
      ]
    },

    {
      "type": "timeseries",
      "id": 33,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 56 },
      "title": "Durée de traitement (audit) — p50 / p95",
      "description": "Latence mesurée côté gateway et loguée dans l'audit trail (duration_ms). Ce panel exploite les métriques Prometheus équivalentes.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 1, "fillOpacity": 5 },
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.50, sum by (le, service_type) (rate(gatewai_llm_request_duration_seconds_bucket{service_type=~\"$service_type\", model=~\"$model\", provider!~\"cache|semantic-cache\"}[5m])))",
          "legendFormat": "{{service_type}} p50",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.95, sum by (le, service_type) (rate(gatewai_llm_request_duration_seconds_bucket{service_type=~\"$service_type\", model=~\"$model\", provider!~\"cache|semantic-cache\"}[5m])))",
          "legendFormat": "{{service_type}} p95",
          "refId": "B"
        }
      ]
    },

    {
      "type": "row",
      "id": 40,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 64 },
      "title": "Top Consumers",
      "collapsed": false
    },

    {
      "type": "bargauge",
      "id": 41,
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 65 },
      "title": "Top consumers — prompt tokens",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "valueMode": "color",
        "showUnfilled": true
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null },
              { "color": "purple", "value": 100000 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sort_desc(gatewai_llm_consumer_tokens_top{type=\"prompt\"})",
          "legendFormat": "{{consumer}} ({{user_type}})",
          "refId": "A"
        }
      ]
    },

    {
      "type": "bargauge",
      "id": 42,
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 65 },
      "title": "Top consumers — completion tokens",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "valueMode": "color",
        "showUnfilled": true
      },
      "fieldConfig": {
